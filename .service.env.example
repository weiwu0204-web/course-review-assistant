# Use URL-safe generated secrets for these localhost preview services.
PPT_DB_ROOT_PASSWORD=
PPT_DB_PASSWORD=
PPT_SERVICE_S3_ACCESS_KEY=
PPT_SERVICE_S3_SECRET_KEY=
PPT_SERVICE_S3_BUCKET=ppt-reviews
PPT_SERVICE_HTTP_PORT=8010
PPT_SERVICE_GENERATOR=demo
# Enable model explicitly, then set these for API and worker:
# PPT_SERVICE_MODEL_API_KEY=
# PPT_SERVICE_MODEL_NAME=
# PPT_SERVICE_MODEL_BASE_URL=https://api.deepseek.com
# Optional: enable auto repair by configuring the actual text model price per million tokens, in CNY.
# PPT_SERVICE_MODEL_PRICE_INPUT=
# PPT_SERVICE_MODEL_PRICE_OUTPUT=
