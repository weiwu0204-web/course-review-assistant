# ---------------------------------------------------------------------------
# AI 服务配置（OpenAI 兼容接口）
# ---------------------------------------------------------------------------
# 必填
AI_API_KEY=sk-your-api-key-here

# DeepSeek（默认，视觉与文本同一个 key 和地址）
AI_BASE_URL=https://api.deepseek.com

# 纯文本模型。
# 注意：deepseek-chat / deepseek-reasoner 已于 2026-07-24 永久停用，
# 现在调用会直接报错，请务必使用下面的 V4 模型名。
AI_MODEL=deepseek-v4-flash

# 视觉模型：仅当本次请求附带了幻灯片图片时才用到它。
# 图片按尺寸折算 token，单张上限 384 tokens，单请求最多 600 张。
AI_VISION_MODEL=deepseek-v4-flash-vision-exp

# 单次生成的最大输出 token。整门课的复习文档建议 >= 8192，否则容易被截断
AI_MAX_TOKENS=16384

# 可选：429/5xx 指数退避自动重试次数（默认 3，覆盖 SDK 默认 2）
AI_MAX_RETRIES=3

# 可选：单次请求总超时秒数（默认 600；视觉 payload 数十 MB + 长文档生成可达数分钟）
AI_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# 服务配置
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
